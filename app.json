{
  "expo": {
    "name": "SmartHouseholdFoodManagement",
    "slug": "smart-household-food-management",
    "scheme": "freshfriends",
    "permissions": [
      "camera",
      "photos",
      "location"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add food images",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of food items"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby stores.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby stores."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07471232-a564-41d8-8fd8-fce2418cf78e"
      }
    },
    "android": {
      "package": "com.thangtran.foodmanagement"
    }
  }
}
