{
  "expo": {
    "name": "SmartHouseholdFoodManagement",
    "slug": "smart-household-food-management",
    "scheme": "freshfriends",
    "permissions": [
      "camera",
      "photos"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "07471232-a564-41d8-8fd8-fce2418cf78e"
      }
    },
    "android": {
      "package": "com.thangtran.foodmanagement"
    }
  }
}
